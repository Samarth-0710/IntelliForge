# ==============================================================================
# INTELLIFORGE 2.0 — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
APP_NAME="IntelliForge SOC Platform"
APP_VERSION="2.0.0"

# Database Configuration
# Local SQLite fallback: sqlite:///./intelliforge.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/intelliforge
DATABASE_URL=sqlite:///./intelliforge.db

# JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI SOC Copilot (Google Gemini 2.5 Flash)
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Threat Intelligence (Tavily Search Engine)
# Get key from: https://tavily.com/
TAVILY_API_KEY=

# Lyzr Agent API
# Get key from: https://lyzr.ai/
LYZR_API_KEY=

# SOAR & Automation (n8n Webhook Endpoint)
# Example: https://your-n8n-instance.com/webhook/soc-incident
N8N_WEBHOOK_URL=

# Email Alert Configuration (Gmail SMTP)
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=

# SMS Alert Configuration (SMS Gateway / Twilio / Custom HTTP)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_ALERT_PHONE=

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000